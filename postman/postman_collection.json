{
  "info": {
    "name": "Next.js App Router - Sandbox API",
    "description": "Integration test collection for backend endpoints featuring environment variables, normalized 3NF schema, JSONB dynamic metadata, and automated assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "test_email",
      "value": "john.doe@gmail.com",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Upsert Age Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"birthDate\": \"1991-08-02\",\n  \"momBirthDate\": \"1965-04-13\",\n  \"dadBirthDate\": \"1960-08-02\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/age",
          "host": ["{{baseUrl}}"],
          "path": ["api", "age"]
        }
      }
    },
    {
      "name": "2. Upsert Club Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"club\": \"Sporting\",\n  \"description\": \"Tested via Postman Collection!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/club",
          "host": ["{{baseUrl}}"],
          "path": ["api", "club"]
        }
      }
    },
    {
      "name": "3. Upsert Metadata JSONB (Initial Creation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('JSONB customData is persisted correctly', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.email).to.eql(pm.variables.get('test_email'));",
              "    pm.expect(jsonData.data.customData.seniority).to.eql('Senior');",
              "    pm.expect(jsonData.data.customData.remoteWorker).to.be.true;",
              "    pm.expect(jsonData.data.customData.techStack).to.include('Rust');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"customData\": {\n    \"seniority\": \"Senior\",\n    \"remoteWorker\": true,\n    \"yearsOfExperience\": 5,\n    \"techStack\": [\"SQL Server\", \"PostgreSQL\", \"Rust\", \"C++\"]\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/metadata",
          "host": ["{{baseUrl}}"],
          "path": ["api", "metadata"]
        }
      }
    },
    {
      "name": "4. Upsert Metadata JSONB (Merge & Audit Update)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('JSONB merges attributes and populates updatedAt', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.updatedAt).to.not.be.null;",
              "    pm.expect(jsonData.data.customData.seniority).to.eql('Senior');",
              "    pm.expect(jsonData.data.customData.yearsOfExperience).to.eql(6);",
              "    pm.expect(jsonData.data.customData.preferredShift).to.eql('Morning');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"customData\": {\n    \"yearsOfExperience\": 6,\n    \"preferredShift\": \"Morning\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/metadata",
          "host": ["{{baseUrl}}"],
          "path": ["api", "metadata"]
        }
      }
    },
    {
      "name": "5. Query Consolidated Record (Stored Procedure)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response holds consolidated relational + JSONB data', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.found).to.be.true;",
              "    pm.expect(jsonData.data.email).to.eql(pm.variables.get('test_email'));",
              "    pm.expect(jsonData.data.club_name).to.eql('Sporting');",
              "    pm.expect(jsonData.data.custom_data).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/results",
          "host": ["{{baseUrl}}"],
          "path": ["api", "results"]
        }
      }
    }
  ]
}
