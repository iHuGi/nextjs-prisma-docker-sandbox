{
  "info": {
    "name": "Next.js App Router - Sandbox API",
    "description": "Integration test collection for backend endpoints featuring environment variables and automated assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "test_email",
      "value": "john.doe@gmail.com",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Upsert Age Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"birthDate\": \"1991-08-02\",\n  \"momBirthDate\": \"1965-04-13\",\n  \"dadBirthDate\": \"1960-08-02\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/age",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "age"
          ]
        }
      }
    },
    {
      "name": "2. Upsert Club Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function () {",
              "    pm.response.to.be.json;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"club\": \"Sporting\",\n  \"description\": \"Tested via Postman Collection!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/club",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "club"
          ]
        }
      }
    },
    {
      "name": "3. Query Consolidated Record (Stored Procedure)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response holds correct data', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.found).to.be.true;",
              "    pm.expect(jsonData.data.email).to.eql(pm.variables.get('test_email'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "results"
          ]
        }
      }
    }
  ]
}